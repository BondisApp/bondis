# ── API GCBA ──────────────────────────────
GCBA_CLIENT_ID=tu_client_id_aqui
GCBA_CLIENT_SECRET=tu_client_secret_aqui

# ── SERVIDOR ──────────────────────────────
PORT=3000
NODE_ENV=development

# ── INTERVALOS ────────────────────────────
GCBA_POLL_INTERVAL=30000   # 30 segundos (igual que la API)
GPS_TIMEOUT=120000          # 2 minutos sin señal = offline

# ── GPS PROPIO (dispositivos Teltonika u otros) ──
# Clave que cada dispositivo debe mandar en el header X-Gps-Key al POST /gps.
# Sin esto configurado, el endpoint queda abierto (solo para pruebas locales).
GPS_SHARED_SECRET=

# ── CORS (dominios permitidos) ────────────
ALLOWED_ORIGINS=http://localhost:5500,https://bondis.com.ar

# ── DATOS GTFS (opcional) ─────────────────
# Carpeta donde se guarda el GTFS descargado de GCBA (~200MB). En Railway,
# apuntar esto a un Volume (disco persistente) hace que sobreviva a
# reinicios y redeploys — sin esto, se vuelve a descargar todo cada vez
# (~10 min sin paradas/ETA hasta que termina). Sin configurar, usa la
# carpeta del proyecto (se pierde en cada redeploy en Railway).
GTFS_DATA_DIR=
